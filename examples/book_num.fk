-- num: a 64-bit floating-point number.
task main() {
    pilot thrust = 2.5
    say thrust * 2.0       -- 5, printed without a trailing .0
    say 10.0 / 4.0
    say 1.0 / 3.0          -- at most ten significant digits are printed
    say 0.1 + 0.2
    say 0.1 + 0.2 == 0.3   -- false: the stored values differ beyond the digits shown

    -- An int and a num can be mixed; the result is a num.
    say 7 / 2
    say 7 / 2.0
    say 3 * 1.5

    say 123456789012.5     -- large and small values switch to scientific notation
    say 0.000001234
}
