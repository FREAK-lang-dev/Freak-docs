-- word: a piece of text.
task main() {
    pilot title = "Muv" + "-" + "Luv"      -- + joins two words
    say title
    say title.length()                     -- 7: one for each of these letters

    pilot mut system = "XM"
    system += "3"                          -- += appends
    say system

    say title == "Muv-Luv"                 -- words compare with == and !=
    say "apple" < "banana"                 -- and are ordered byte by byte

    -- A name in braces is replaced by its value. It works for
    -- word, int, num and bool pilots.
    pilot sorties = 12
    pilot ratio = 0.75
    pilot cleared = true
    say "{title}: {sorties} sorties, ratio {ratio}, cleared {cleared}"

    -- A backslash before a brace prints the brace itself.
    say "\{sorties\} is printed as written"

    -- A backslash introduces a character that is awkward to type.
    say "tab:[\t] quote:[\"] backslash:[\\]"
}
