-- Step 3: a secret number between 1 and 100.
-- V3 has no random-number library, so the clock supplies the unpredictability.
task secret_number() -> int {
    pilot micros = time::monotonic_ns() / 1000
    give back micros % 100 + 1
}

task main() {
    pilot secret = secret_number()
    if secret >= 1 and secret <= 100 {
        say "The secret is somewhere from 1 to 100."
    } else {
        say "Something is wrong with the secret: {secret}"
    }
}
