-- repeat N times
task main() {
    repeat 3 times {
        say "Valkyries, sound off"
    }

    -- A bare `repeat N times` has no counter. Keep one yourself, or write
    -- `repeat N times with i` for one that starts at 0.
    pilot mut number = 1
    repeat 3 times {
        say "Valkyrie-{number}"
        number += 1
    }

    -- The count is worked out once, before the first pass.
    pilot mut passes = 2
    repeat passes times {
        passes += 10
        say "pass (passes is now {passes})"
    }

    -- Zero or a negative count means the body never runs.
    repeat 0 times { say "never printed" }
}
