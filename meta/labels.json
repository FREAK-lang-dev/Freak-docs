    "gen": "8c50ff",
    "stratum": "6478ff",
    "area": "3cb4ff",
    "kind": "2ea043",
    "bible": "ff64c8",
    "status": "9aa0a6",
    "prio": "d73a4a",
    "platform": "6e7781",
    "backend": "dc50dc",
    "flag": "b60205"
  },
  "sets": {
